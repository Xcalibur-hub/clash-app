{
  "name": "clash_p11bind_example",
  "services": {
    "db": {
      "image": "public.ecr.aws/supabase/postgres:17.6.1.002@sha256:3f5e3b691d5887161e1b977302b66122eb6cfdf2a6358bdad493454efb75f8a6",
      "platform": "linux/amd64",
      "restart": "no",
      "environment": {
        "POSTGRES_PASSWORD": "postgres",
        "POSTGRES_HOST": "/var/run/postgresql",
        "JWT_SECRET": "${JWT_SECRET:?generate fresh disposable values}",
        "JWT_EXP": "3600",
        "PGSODIUM_ROOT_KEY": "${PGSODIUM_ROOT_KEY:?generate fresh disposable values}"
      },
      "networks": [
        "isolated"
      ],
      "entrypoint": [
        "/bin/sh",
        "/bootstrap/db-entrypoint.sh"
      ],
      "ports": [
        {
          "host_ip": "127.0.0.1",
          "target": 5432,
          "published": "57722",
          "protocol": "tcp"
        }
      ],
      "volumes": [
        "db-data:/var/lib/postgresql/data",
        "db-config:/etc/postgresql-custom",
        "./bootstrap:/bootstrap:ro",
        "./tests:/tests:ro"
      ],
      "healthcheck": {
        "test": [
          "CMD",
          "pg_isready",
          "-U",
          "postgres",
          "-h",
          "127.0.0.1",
          "-p",
          "5432"
        ],
        "interval": "2s",
        "timeout": "2s",
        "retries": 60,
        "start_period": "10s"
      }
    },
    "realtime-init": {
      "image": "public.ecr.aws/supabase/realtime:v2.47.0@sha256:6b26b3679de63aec6b4849c02140d8f55b65ce2eecadcd5e5b712f596d0249a2",
      "platform": "linux/amd64",
      "restart": "no",
      "environment": {
        "PORT": "4000",
        "DB_HOST": "db",
        "DB_PORT": "5432",
        "DB_USER": "supabase_admin",
        "DB_PASSWORD": "postgres",
        "DB_NAME": "postgres",
        "DB_AFTER_CONNECT_QUERY": "SET search_path TO _realtime",
        "DB_ENC_KEY": "${DB_ENC_KEY:?generate fresh disposable values}",
        "API_JWT_SECRET": "${JWT_SECRET:?generate fresh disposable values}",
        "METRICS_JWT_SECRET": "${JWT_SECRET:?generate fresh disposable values}",
        "APP_NAME": "realtime",
        "SECRET_KEY_BASE": "${SECRET_KEY_BASE:?generate fresh disposable values}",
        "ERL_AFLAGS": "-proto_dist inet_tcp",
        "DNS_NODES": "''",
        "RLIMIT_NOFILE": "",
        "SEED_SELF_HOST": "true",
        "RUN_JANITOR": "true",
        "MAX_HEADER_LENGTH": "4096"
      },
      "networks": [
        "isolated"
      ],
      "command": [
        "/app/bin/realtime",
        "eval",
        "{:ok, _} = Application.ensure_all_started(:realtime)\n{:ok, _} = Realtime.Tenants.health_check(\"realtime-dev\")"
      ]
    },
    "storage-init": {
      "image": "public.ecr.aws/supabase/storage-api:v1.26.5@sha256:e6b603040889a574b641b46f7876dfae1d0aa5c3c2e07eb0551f812c0f5ccb6c",
      "platform": "linux/amd64",
      "restart": "no",
      "environment": {
        "DB_INSTALL_ROLES": "false",
        "DB_MIGRATIONS_FREEZE_AT": "",
        "ANON_KEY": "${ANON_KEY:?generate fresh disposable values}",
        "SERVICE_KEY": "${SERVICE_KEY:?generate fresh disposable values}",
        "DATABASE_URL": "postgresql://supabase_storage_admin:postgres@db:5432/postgres",
        "FILE_SIZE_LIMIT": "52428800",
        "STORAGE_BACKEND": "file",
        "TENANT_ID": "stub",
        "GLOBAL_S3_BUCKET": "stub",
        "PGRST_JWT_SECRET": "${JWT_SECRET:?generate fresh disposable values}",
        "STORAGE_FILE_BACKEND_PATH": "/mnt",
        "REGION": "stub"
      },
      "networks": [
        "isolated"
      ],
      "command": [
        "node",
        "dist/scripts/migrate-call.js"
      ]
    },
    "auth-init": {
      "image": "public.ecr.aws/supabase/gotrue:v2.179.0@sha256:658cf69f57d48e10cbe508a79874e6067348b82a4d216a0bb446c067d7a246f9",
      "platform": "linux/amd64",
      "restart": "no",
      "environment": {
        "API_EXTERNAL_URL": "http://127.0.0.1:57721",
        "GOTRUE_LOG_LEVEL": "error",
        "GOTRUE_DB_DRIVER": "postgres",
        "GOTRUE_DB_DATABASE_URL": "postgresql://supabase_auth_admin:postgres@db:5432/postgres",
        "GOTRUE_SITE_URL": "http://127.0.0.1:57721",
        "GOTRUE_JWT_SECRET": "${JWT_SECRET:?generate fresh disposable values}"
      },
      "networks": [
        "isolated"
      ],
      "command": [
        "gotrue",
        "migrate"
      ]
    },
    "auth": {
      "image": "public.ecr.aws/supabase/gotrue:v2.179.0@sha256:658cf69f57d48e10cbe508a79874e6067348b82a4d216a0bb446c067d7a246f9",
      "platform": "linux/amd64",
      "restart": "no",
      "environment": {
        "API_EXTERNAL_URL": "http://127.0.0.1:57721",
        "GOTRUE_LOG_LEVEL": "error",
        "GOTRUE_DB_DRIVER": "postgres",
        "GOTRUE_DB_DATABASE_URL": "postgresql://supabase_auth_admin:postgres@db:5432/postgres",
        "GOTRUE_SITE_URL": "http://127.0.0.1:57721",
        "GOTRUE_JWT_SECRET": "${JWT_SECRET:?generate fresh disposable values}",
        "GOTRUE_API_HOST": "0.0.0.0",
        "GOTRUE_API_PORT": "9999",
        "GOTRUE_JWT_ADMIN_ROLES": "service_role",
        "GOTRUE_JWT_AUD": "authenticated",
        "GOTRUE_JWT_DEFAULT_GROUP_NAME": "authenticated",
        "GOTRUE_JWT_EXP": "3600",
        "GOTRUE_JWT_ISSUER": "http://127.0.0.1:57721/auth/v1",
        "GOTRUE_EXTERNAL_EMAIL_ENABLED": "true",
        "GOTRUE_MAILER_AUTOCONFIRM": "true",
        "GOTRUE_EXTERNAL_PHONE_ENABLED": "false",
        "GOTRUE_EXTERNAL_ANONYMOUS_USERS_ENABLED": "false"
      },
      "networks": [
        "isolated"
      ],
      "healthcheck": {
        "test": [
          "CMD",
          "wget",
          "--no-verbose",
          "--tries=1",
          "--spider",
          "http://127.0.0.1:9999/health"
        ],
        "interval": "2s",
        "timeout": "2s",
        "retries": 60,
        "start_period": "10s"
      }
    },
    "rest": {
      "image": "public.ecr.aws/supabase/postgrest:v13.0.6@sha256:6797796b22aa5df4be1cdf4e52d9e8f6b202ecdfbfcd9d867648c44a8bac1a1e",
      "platform": "linux/amd64",
      "restart": "no",
      "environment": {
        "PGRST_DB_URI": "postgresql://authenticator:postgres@db:5432/postgres",
        "PGRST_DB_SCHEMAS": "public,graphql_public",
        "PGRST_DB_EXTRA_SEARCH_PATH": "public,extensions",
        "PGRST_DB_MAX_ROWS": "1000",
        "PGRST_DB_ANON_ROLE": "anon",
        "PGRST_JWT_SECRET": "${JWT_SECRET:?generate fresh disposable values}",
        "PGRST_ADMIN_SERVER_PORT": "3001"
      },
      "networks": [
        "isolated"
      ]
    },
    "realtime": {
      "image": "public.ecr.aws/supabase/realtime:v2.47.0@sha256:6b26b3679de63aec6b4849c02140d8f55b65ce2eecadcd5e5b712f596d0249a2",
      "platform": "linux/amd64",
      "restart": "no",
      "environment": {
        "PORT": "4000",
        "DB_HOST": "db",
        "DB_PORT": "5432",
        "DB_USER": "supabase_admin",
        "DB_PASSWORD": "postgres",
        "DB_NAME": "postgres",
        "DB_AFTER_CONNECT_QUERY": "SET search_path TO _realtime",
        "DB_ENC_KEY": "${DB_ENC_KEY:?generate fresh disposable values}",
        "API_JWT_SECRET": "${JWT_SECRET:?generate fresh disposable values}",
        "METRICS_JWT_SECRET": "${JWT_SECRET:?generate fresh disposable values}",
        "APP_NAME": "realtime",
        "SECRET_KEY_BASE": "${SECRET_KEY_BASE:?generate fresh disposable values}",
        "ERL_AFLAGS": "-proto_dist inet_tcp",
        "DNS_NODES": "''",
        "RLIMIT_NOFILE": "",
        "SEED_SELF_HOST": "true",
        "RUN_JANITOR": "true",
        "MAX_HEADER_LENGTH": "4096"
      },
      "networks": {
        "isolated": {
          "aliases": [
            "realtime-dev"
          ]
        }
      },
      "healthcheck": {
        "test": [
          "CMD",
          "curl",
          "-sSfL",
          "--head",
          "-o",
          "/dev/null",
          "-H",
          "Host:realtime-dev",
          "http://127.0.0.1:4000/api/ping"
        ],
        "interval": "2s",
        "timeout": "2s",
        "retries": 60,
        "start_period": "10s"
      }
    },
    "storage": {
      "image": "public.ecr.aws/supabase/storage-api:v1.26.5@sha256:e6b603040889a574b641b46f7876dfae1d0aa5c3c2e07eb0551f812c0f5ccb6c",
      "platform": "linux/amd64",
      "restart": "no",
      "environment": {
        "DB_INSTALL_ROLES": "false",
        "DB_MIGRATIONS_FREEZE_AT": "",
        "ANON_KEY": "${ANON_KEY:?generate fresh disposable values}",
        "SERVICE_KEY": "${SERVICE_KEY:?generate fresh disposable values}",
        "DATABASE_URL": "postgresql://supabase_storage_admin:postgres@db:5432/postgres",
        "FILE_SIZE_LIMIT": "52428800",
        "STORAGE_BACKEND": "file",
        "TENANT_ID": "stub",
        "GLOBAL_S3_BUCKET": "stub",
        "AUTH_JWT_SECRET": "${JWT_SECRET:?generate fresh disposable values}",
        "FILE_STORAGE_BACKEND_PATH": "/mnt",
        "STORAGE_S3_REGION": "local",
        "ENABLE_IMAGE_TRANSFORMATION": "false",
        "TUS_URL_PATH": "/storage/v1/upload/resumable",
        "S3_PROTOCOL_ACCESS_KEY_ID": "${S3_ACCESS_KEY:?generate fresh disposable values}",
        "S3_PROTOCOL_ACCESS_KEY_SECRET": "${S3_SECRET_KEY:?generate fresh disposable values}",
        "S3_PROTOCOL_PREFIX": "/storage/v1",
        "UPLOAD_FILE_SIZE_LIMIT": "52428800000",
        "UPLOAD_FILE_SIZE_LIMIT_STANDARD": "5242880000"
      },
      "networks": [
        "isolated"
      ],
      "volumes": [
        "storage-data:/mnt"
      ],
      "healthcheck": {
        "test": [
          "CMD",
          "wget",
          "--no-verbose",
          "--tries=1",
          "--spider",
          "http://127.0.0.1:5000/status"
        ],
        "interval": "2s",
        "timeout": "2s",
        "retries": 60,
        "start_period": "10s"
      }
    },
    "kong": {
      "image": "public.ecr.aws/supabase/kong:2.8.1@sha256:1b53405d8680a09d6f44494b7990bf7da2ea43f84a258c59717d4539abf09f6d",
      "platform": "linux/amd64",
      "restart": "no",
      "environment": {
        "KONG_DATABASE": "off",
        "KONG_DECLARATIVE_CONFIG": "/home/kong/kong.yml",
        "KONG_PROXY_LISTEN": "0.0.0.0:8000",
        "KONG_ADMIN_LISTEN": "off",
        "KONG_PLUGINS": "request-transformer,cors",
        "KONG_DNS_ORDER": "LAST,A,CNAME"
      },
      "networks": [
        "isolated"
      ],
      "ports": [
        {
          "host_ip": "127.0.0.1",
          "target": 8000,
          "published": "57721",
          "protocol": "tcp"
        }
      ],
      "volumes": [
        "./kong.yml:/home/kong/kong.yml:ro"
      ],
      "healthcheck": {
        "test": [
          "CMD",
          "kong",
          "health"
        ],
        "interval": "2s",
        "timeout": "2s",
        "retries": 60,
        "start_period": "10s"
      }
    }
  },
  "networks": {
    "isolated": {
      "name": "clash_p11bind_example_network",
      "driver": "bridge"
    }
  },
  "volumes": {
    "db-data": {
      "name": "clash_p11bind_example_db-data"
    },
    "db-config": {
      "name": "clash_p11bind_example_db-config"
    },
    "storage-data": {
      "name": "clash_p11bind_example_storage-data"
    }
  }
}
