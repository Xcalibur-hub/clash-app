03:30:31.100 [info] execute "create function realtime.is_visible_through_filters(columns realtime.wal_column[], filters realtime.user_defined_filter[])\n      returns bool\n      language sql\n      immutable\n    as $$\n    /*\n    Should the record be visible (true) or filtered out (false) after *filters* are applied\n    */\n    select\n      -- Default to allowed when no filters present\n      coalesce(\n        sum(\n          realtime.check_equality_op(\n            op:=f.op,\n            type_:=col.type::regtype,\n            -- cast jsonb to text\n            val_1:=col.value #>> '{}',\n            val_2:=f.value\n          )::int\n        ) = count(1),\n        true\n      )\n    from\n      unnest(filters) f\n      join unnest(columns) col\n          on f.column_name = col.name;\n    $$;"
