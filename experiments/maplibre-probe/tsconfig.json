{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": ["node"]
  },
  "include": [
    "src/probeCoordinates.js",
    "src/probeCluster.js",
    "src/probeDrops.js",
    "src/probeSelection.js"
  ],
  "exclude": ["node_modules", "android", "ios", "src/**/*.test.js", "App.js", "index.js"]
}
