# ============================================================================
# CLASH 2.0 — environment template
# ----------------------------------------------------------------------------
# Copy this file to `.env` for local development:
#
#   cp .env.example .env              # macOS / Linux
#   Copy-Item .env.example .env       # Windows PowerShell
#
# `.env` and every `.env.*` file are gitignored. Never commit real values.
#
# Only EXPO_PUBLIC_* values belong here. Expo inlines them into the client bundle
# at build time, so treat every one of them as public. The publishable key is
# safe to ship: Row Level Security and the column grants in
# `supabase/migrations/` decide what it can actually read or write.
#
# A service-role key is NOT public. It must never appear in this file, in
# app.config.ts, in eas.json, or anywhere else the app bundle can reach.
# ============================================================================

# ---- Supabase (client) -----------------------------------------------------
# Local stack  → printed by `npm run supabase:start`
#                (e.g. http://127.0.0.1:54321 plus the local publishable key)
# Hosted       → Dashboard → Project Settings → API
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# ---- Observability (optional) ----------------------------------------------
# Sentry DSN for crash reporting. Leave empty for local development — the app
# falls back to console logging (services/logger.ts). A DSN is a public client
# key; never put a service key or Sentry auth token here.
# Reporting is enabled only for preview/production release builds when set.
EXPO_PUBLIC_SENTRY_DSN=

# Set to 1 ONLY on a deliberate test preview build to show the "Sentry test"
# crash button. Never set this on store production. Leave empty otherwise.
EXPO_PUBLIC_SENTRY_TEST=

# Build-time only (EAS secrets / local .env.local — NOT EXPO_PUBLIC, never commit):
#   SENTRY_AUTH_TOKEN   — auth token with project:releases + org:read scopes
#   SENTRY_ORG          — Sentry organization slug
#   SENTRY_PROJECT      — Sentry project slug
# Used by @sentry/react-native/expo for source-map upload during native builds.

# ---- Product analytics (optional) ------------------------------------------
# PostHog project API key + host. Leave empty for local development — the app
# continues normally with analytics no-ops (services/analytics.ts).
# Reporting defaults to preview/production release builds only.
EXPO_PUBLIC_POSTHOG_API_KEY=
EXPO_PUBLIC_POSTHOG_HOST=

# Set to 1 to force analytics + console event logs during local development.
EXPO_PUBLIC_ANALYTICS_DEBUG=

# ---- Google Maps (optional for Expo Go; required for Android store builds) --
# Create a Maps SDK for Android (and optionally iOS) key in Google Cloud.
# Restrict by package/bundle + SHA-1. Never commit a unrestricted key.
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=

# ============================================================================
# Per-environment files
# ----------------------------------------------------------------------------
# Expo loads these automatically, later files overriding earlier ones:
#
#   .env                 shared defaults (this template)
#   .env.development     `npx expo start`, dev builds
#   .env.production      production builds
#   .env.local           this machine only — gitignored, never committed
#
# Keep one Supabase project per environment and never point development at the
# production database. EAS builds read their values from the Environment
# Variables attached to the matching profile in `eas.json`.
# ============================================================================
