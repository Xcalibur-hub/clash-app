{
  "name": "CLASH cloud preparation",
  "image": "mcr.microsoft.com/devcontainers/base:1-bookworm",
  "features": {
    "ghcr.io/devcontainers/features/node:2.1.2": {
      "version": "22.23.5", "npmVersion": "11.6.0", "pnpmVersion": "none", "nodeGypDependencies": true
    },
    "ghcr.io/devcontainers/features/git:1.3.8": { "version": "os-provided", "ppa": false },
    "ghcr.io/devcontainers/features/powershell:2.0.4": { "version": "7.4", "preserveHistory": false }
  },
  "remoteUser": "vscode",
  "postCreateCommand": "node --version && npm --version && git --version && pwsh -NoProfile -Command '$PSVersionTable.PSVersion.ToString()'",
  "customizations": { "vscode": { "extensions": ["ms-vscode.powershell"] } }
}
